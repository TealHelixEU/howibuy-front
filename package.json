{
  "name": "howibuy-front",
  "version": "0.2.0",
  "type": "module",
  "overrides": {
    "unrs-resolver": "1.11.1"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "npm run typecheck && vite build --configLoader native",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview --configLoader native",
    "lint": "eslint",
    "test": "vitest --configLoader native",
    "test:run": "vitest run --configLoader native",
    "coverage": "vitest run --coverage --configLoader native"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "i18next": "27.1.0",
    "jotai": "3.0.2",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-icons": "5.7.0",
    "react-oidc-context": "3.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@nabla/vite-plugin-eslint": "3.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "daisyui": "5.7.50",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
